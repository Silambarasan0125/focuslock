<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#101426" />
            <stroke android:width="2dp" android:color="@color/focus_accent" />
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#101426" />
            <stroke android:width="1dp" android:color="#515B7A" />
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
