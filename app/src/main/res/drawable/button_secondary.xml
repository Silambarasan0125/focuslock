<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#29304E" />
            <stroke android:width="1dp" android:color="@color/focus_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141A30" />
            <stroke android:width="1dp" android:color="@color/focus_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
