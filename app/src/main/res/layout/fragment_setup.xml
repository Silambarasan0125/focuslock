<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:contentDescription="@string/lock_icon_description"
            android:scaleType="fitCenter"
            android:src="@drawable/focuslock_mascot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/setup_eyebrow"
            android:textColor="@color/focus_accent"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/setup_password_title"
            android:textColor="@color/focus_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/setup_password_subtitle"
            android:textColor="@color/focus_text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/surface_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/setup_password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_background"
                android:hint="@string/setup_password_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/focus_text"
                android:textColorHint="@color/focus_text_muted" />

            <EditText
                android:id="@+id/setup_confirm_password_edit_text"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/input_field_background"
                android:hint="@string/setup_confirm_password_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/focus_text"
                android:textColorHint="@color/focus_text_muted" />

            <TextView
                android:id="@+id/setup_password_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_password_rule"
                android:textColor="@color/focus_text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/setup_save_password_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:text="@string/setup_save_password_button_text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
